# Configuración de Caddy de referencia (se copia tal cual a /etc/caddy/Caddyfile; las
# credenciales de la puerta de entrada van en el .env del servidor, no aquí).
#
# El juego se sirve en https://aeonarch.de a través de Cloudflare (proxy):
# - Cloudflare -> servidor va cifrado con un certificado de origen de Cloudflare
#   (/etc/caddy/certs, válido hasta 2041) y el modo SSL "Full (strict)".
# - El cortafuegos (UFW) solo acepta 80/443 desde las IP de Cloudflare.
# - Como solo entra tráfico de Cloudflare, la cabecera CF-Connecting-IP (la IP
#   real del jugador, puesta por Cloudflare) es de fiar y se pasa al juego para
#   sus límites por IP. (La versión de Caddy de Ubuntu, 2.6, no tiene
#   trusted_proxies.) Si algún día se abre 80/443 a todo el mundo, esto deja de
#   ser seguro. Lista de IP de Cloudflare: https://www.cloudflare.com/ips/
aeonarch.de, www.aeonarch.de {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip

	# Cabeceras de seguridad. El juego y la Wiki no cargan nada de fuera ni
	# scripts en línea, así que la CSP es estricta; la página de la puerta trae su
	# propia CSP (con su script en línea) y por eso aquí va con «?» (solo si falta).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://aeonarch.de wss://www.aeonarch.de; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Puerta de entrada propia (antes de abrir al público): su página y su API van
	# sin protección; todo lo demás (salvo /legal/*, que la ley exige que sea
	# público) solo con la cookie de la puerta, que comprueba el juego
	# (apps/server/src/gate; variables GATE_* del .env).
	@gate path /puerta/*
	handle @gate {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	@protected not path /legal/* /puerta/*
	forward_auth @protected 127.0.0.1:3000 {
		uri /puerta/check
	}

	# API y WebSocket: al servidor de juego, que solo escucha en la máquina local.
	@game path /api/* /ws
	handle @game {
		reverse_proxy 127.0.0.1:3000 {
			# La IP real del jugador (no la de Cloudflare) para los límites del juego.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# La Wiki (/wiki/, /wiki/<tema>/) son archivos del cliente compilado
	# (wiki/<tema>/index.html): no necesita reglas propias y queda tras la puerta de entrada.
	# Todo lo demás: el cliente compilado. Los archivos con huella en el nombre
	# (assets/*) no cambian nunca: caché larga en Cloudflare y en el navegador.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	handle {
		root * /var/www/aeonarch
		file_server
	}
}
