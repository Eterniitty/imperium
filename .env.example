# Copia este archivo como .env y rellena los valores. El archivo .env NUNCA se sube a GitHub.

# --- Cliente (Fase 3) ---
# Semilla global del universo. Cambiarla genera un universo distinto.
VITE_UNIVERSE_SEED=imperium-alpha

# --- Servidor (Fase 4) ---
# Entorno: development | staging (servidor de pruebas cerrado) | production.
# En production el servidor exige MAIL_TRANSPORT=smtp, COOKIE_SECURE=true y PUBLIC_URL con https.
APP_ENV=development
# Dirección y puerto del servidor de juego. Solo debe escuchar en la máquina
# local: al exterior se llega a través de Caddy, nunca abriendo el puerto.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=3000
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# PostgreSQL. Con ?host=/var/run/postgresql se conecta por socket local, sin contraseña
# (el usuario de PostgreSQL debe llamarse igual que el del sistema).
DATABASE_URL=postgres://imperium@localhost/imperium?host=/var/run/postgresql
# Base de datos para los tests de integración; SE BORRA en cada ejecución. Sin ella, se saltan.
# TEST_DATABASE_URL=postgres://imperium@localhost/imperium_test?host=/var/run/postgresql

# Dirección pública del cliente: los enlaces de acceso apuntan aquí.
PUBLIC_URL=http://localhost:5173
# console: el enlace de acceso se escribe en el registro del servidor (solo desarrollo y pruebas).
MAIL_TRANSPORT=console
# Sin HTTPS (desarrollo, pruebas por http) el navegador no guarda cookies Secure.
COOKIE_SECURE=false

# --- Servidor (próximos pasos, todavía no se usan) ---
