# Copia este archivo como .env y rellena los valores. El archivo .env NUNCA se sube a GitHub.

# --- Cliente (Fase 3) ---
# Semilla global del universo. Cambiarla genera un universo distinto.
VITE_UNIVERSE_SEED=imperium-alpha

# --- Servidor (Fase 4) ---
# Dirección y puerto del servidor de juego. Solo debe escuchar en la máquina
# local: al exterior se llega a través de Caddy, nunca abriendo el puerto.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=3000
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# --- Servidor (próximos pasos de la Fase 4, todavía no se usan) ---
# NODE_ENV=development
# DATABASE_URL=postgres://imperium:CAMBIAR@localhost:5432/imperium
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=CAMBIAR_POR_UNA_CADENA_ALEATORIA_LARGA
# MAIL_TRANSPORT=console        # solo desarrollo; en producción: smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="IMPERIUM <no-reply@tu-dominio>"
