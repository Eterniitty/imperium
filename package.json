{
  "name": "imperium",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "IMPERIUM — MMO espacial 3D para navegador",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @imperium/client dev",
    "dev:server": "pnpm --filter @imperium/server dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @imperium/client preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@imperium/procgen": "workspace:*",
    "@imperium/shared": "workspace:*",
    "@imperium/sim": "workspace:*",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
